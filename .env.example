# Reference only: export the values needed by the command you are running.
# Do not commit a populated .env file.

# Local state
VISA_AGENT_DB_PATH=visa-agent.sqlite3
VISA_AGENT_ATTACHMENT_DIR=inbound-attachments

# Dedicated SMTP/IMAP test mailbox
VISA_AGENT_SMTP_HOST=smtp.gmail.com
VISA_AGENT_SMTP_PORT=587
VISA_AGENT_IMAP_HOST=imap.gmail.com
VISA_AGENT_IMAP_PORT=993
VISA_AGENT_EMAIL_USER=visa-agent-demo@example.com
VISA_AGENT_EMAIL_PASSWORD=<mailbox-app-password>
VISA_AGENT_FROM_EMAIL=visa-agent-demo@example.com
VISA_AGENT_TO_EMAIL=client-test@example.com

# Optional OpenAI-compatible intake and document extraction
VISA_AGENT_LLM_API_KEY=<provider-api-key>
VISA_AGENT_LLM_MODEL=deepseek-v4-flash
VISA_AGENT_LLM_BASE_URL=https://api.deepseek.com
VISA_AGENT_LLM_TIMEOUT=20

# Optional whole-case analysis model
VISA_AGENT_CASE_ANALYSIS_LLM=0
VISA_AGENT_CASE_ANALYSIS_LLM_MODEL=deepseek-v4-pro
VISA_AGENT_CASE_ANALYSIS_LLM_TIMEOUT=60

# Optional OCR for images and scanned PDFs
VISA_AGENT_BAIDU_OCR_API_KEY=<baidu-api-key>
VISA_AGENT_BAIDU_OCR_SECRET_KEY=<baidu-secret-key>
VISA_AGENT_BAIDU_OCR_TIMEOUT=20
VISA_AGENT_BAIDU_OCR_LANGUAGE=ENG
